# Shell scripts and the Dockerfile must use LF endings so they run on Linux
# (a CRLF shebang/line breaks `sh` inside the container).
*.sh text eol=lf
docker-entrypoint.sh text eol=lf
Dockerfile text eol=lf
# systemd units, Caddyfile and the compose file are consumed on the Linux VM.
*.service text eol=lf
*.timer text eol=lf
deploy/Caddyfile text eol=lf
deploy/docker-compose.prod.yml text eol=lf
