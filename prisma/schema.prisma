generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Temporarily on SQLite for local beta (no Docker/Postgres required).
  // Switch back to "postgresql" for staging/production.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite does not support Prisma enums, so roles/status/types are stored
// as TEXT. Allowed values are enforced in application code:
//   - Role          -> src/lib/auth.ts
//   - InvoiceStatus  -> src/lib/invoices.ts
//   - Company/club roles & legal-entity type -> src/lib/access.ts

// ---------------------------------------------------------------------------
// Tenancy: Company -> Club, plus legal entities (ООО / ИП)
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  inn       String?
  kpp       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubs         Club[]
  legalEntities LegalEntity[]
  userAccess    CompanyUserAccess[]
  invites       Invite[]
  invoices      Invoice[]
  expenses      Expense[]
  sales         Sale[]
  refunds       Refund[]
  budgets       Budget[]
  budgetRequests BudgetApprovalRequest[]
  payrollStatements PayrollStatement[]
  salesPlans    SalesPlan[]
  salesReports  SalesReport[]
  importBatches ImportBatch[]
  monthCloses   MonthClose[]
  monthReopenRequests MonthReopenRequest[]
  mandatoryPayments MandatoryPaymentPlan[]
  balanceSnapshots BalanceSnapshot[]
  clubEmployees ClubEmployee[]
  cashWallets   CashWallet[]
  cashMovements CashMovement[]
  cashNotifications CashNotification[]
}

model LegalEntity {
  id            String   @id @default(cuid())
  companyId     String
  // "ooo" | "ip" (legacy seed data may use "ООО"/"ИП" — normalize in code).
  type          String
  // `name` is the primary display name (kept for back-compat). Full profile
  // below; everything nullable so existing rows are unaffected.
  name          String
  fullName      String?
  shortName     String?
  inn           String?
  kpp           String?
  ogrn          String?
  legalAddress  String?
  phone         String?
  email         String?
  bankName      String?
  bankBik       String?
  accountNumber String? // расчётный счёт (bank account)
  corrAccount   String?
  directorName  String?
  comment       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clubs           ClubLegalEntity[]
  invoices        Invoice[]
  expenses        Expense[]
  sales           Sale[]
  salesReportLines SalesReportLine[]
  balanceSnapshots BalanceSnapshot[]
  mandatoryPayments MandatoryPaymentPlan[]
  cashWallets       CashWallet[]

  @@index([companyId])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  role            String
  passwordHash    String?
  firstName       String?
  lastName        String?
  phone           String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Global platform role, SEPARATE from Company/Club access. SQLite has no
  // enums, so this is TEXT; the only valid value is "system_admin" (see
  // lib/system-role.ts). null = ordinary user. Never granted via tenant roles.
  systemRole String?

  // Soft-deletion / tombstone lifecycle (Part 3). The User row is NEVER
  // physically deleted (financial createdBy relations are onDelete: Restrict).
  deletedAt           DateTime?
  restoreUntil        DateTime?
  deletionRequestedAt DateTime?
  recoveryPurgedAt    DateTime?

  clubAccess    UserClubAccess[]
  companyAccess CompanyUserAccess[]
  clubRoles     ClubUserAccess[]
  sessions      Session[]
  otpChallenges EmailOtpChallenge[]
  invitesSent   Invite[]
  invoices      Invoice[]
  expenses      Expense[]           @relation("ExpenseCreatedBy")
  expensesPaidBy Expense[]          @relation("ExpensePaidBy")
  sales         Sale[]
  refunds       Refund[]
  budgetsCreated          Budget[]                @relation("BudgetCreatedBy")
  budgetRequestsRequested BudgetApprovalRequest[] @relation("BudgetReqRequestedBy")
  budgetRequestsDecided   BudgetApprovalRequest[] @relation("BudgetReqDecidedBy")
  payrollStatements       PayrollStatement[]
  salesPlans              SalesPlan[]
  salesReportsCreated     SalesReport[]           @relation("SalesReportCreatedBy")
  mandatoryPaymentsCreated     MandatoryPaymentPlan[] @relation("MandatoryPaymentCreatedBy")
  mandatoryPaymentsResponsible MandatoryPaymentPlan[] @relation("MandatoryPaymentResponsible")
  balanceSnapshotsCreated      BalanceSnapshot[]      @relation("BalanceSnapshotCreatedBy")
  accountDeletions             AccountDeletion[]
}

// Recovery record for a soft-deleted (tombstoned) account (Part 3/10/11). Holds
// the AES-256-GCM-encrypted original email + an HMAC hash for lookup, and the
// HMAC of a single-use recovery token. Sensitive fields are purged after the
// 30-day window (Part 13). Never stores plaintext email/token.
model AccountDeletion {
  id                     String    @id @default(cuid())
  userId                 String
  requestedByUserId      String?
  requestType            String // "self" | "owner" | "system_admin"
  originalEmailEncrypted String? // base64(iv|tag|ciphertext), AES-256-GCM; null after purge
  originalEmailHash      String // HMAC(ACCOUNT_RECOVERY_SECRET, normalizedEmail)
  originalEmailMasked    String
  restoreTokenHash       String?   @unique // HMAC of the recovery token; null after use/purge
  restoreUntil           DateTime
  confirmedAt            DateTime?
  deletedAt              DateTime?
  restoredAt             DateTime?
  recoveryPurgedAt       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([originalEmailHash])
  @@index([restoreUntil])
  @@index([deletedAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Activity + revocation metadata (Part 2). A session is valid only when
  // revokedAt IS NULL, expiresAt is in the future, and the owner is active.
  // Revoked rows are kept for security investigation (retention cleanup later).
  lastSeenAt      DateTime  @default(now())
  revokedAt       DateTime?
  revokedReason   String?
  revokedByUserId String? // opaque actor id; nullable for self/system revokes
  // Sanitized user-agent + derived human label ("Chrome · Windows"). No raw IP
  // and no geolocation is stored (documented future extension if ever needed).
  userAgent       String?
  deviceLabel     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// Email OTP (second factor). Mandatory on every login: a Session is created only
// after a challenge is verified. Never stores the plaintext OTP (only an
// HMAC digest keyed by OTP_SECRET) nor the raw challenge token (only its HMAC).
model EmailOtpChallenge {
  id                 String    @id @default(cuid())
  userId             String
  challengeTokenHash String    @unique // HMAC of the opaque cookie token
  otpDigest          String              // HMAC(OTP_SECRET, challengeTokenHash:otp)
  purpose            String    @default("login")
  expiresAt          DateTime
  resendAvailableAt  DateTime
  attemptCount       Int       @default(0)
  maxAttempts        Int       @default(5)
  sendCount          Int       @default(1)
  lastSentAt         DateTime  @default(now())
  consumedAt         DateTime?
  revokedAt          DateTime?
  revokedReason      String?
  deliveryFailedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([revokedAt])
}

model Club {
  id        String   @id @default(cuid())
  companyId String
  name      String
  city      String
  // Soft-archive: archived clubs are hidden from selectors and reject new
  // operations, but their financial history is preserved.
  isActive   Boolean   @default(true)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userAccess    UserClubAccess[]
  clubRoles     ClubUserAccess[]
  legalEntities ClubLegalEntity[]
  invites       Invite[]
  invoices      Invoice[]
  expenses      Expense[]
  sales         Sale[]
  refunds       Refund[]
  budgets       Budget[]
  budgetRequests BudgetApprovalRequest[]
  payrollStatements PayrollStatement[]
  salesPlans    SalesPlan[]
  salesReports  SalesReport[]
  mandatoryPayments MandatoryPaymentPlan[]
  balanceSnapshots BalanceSnapshot[]
  clubEmployees ClubEmployee[]
  cashWallets   CashWallet[]
  cashMovements CashMovement[]

  @@index([companyId])
}

// A club can be served by multiple legal entities (e.g. ООО + ИП).
// `isActive` marks the CURRENTLY-active association for its (club, entity-type):
// replacing the active ООО/ИП soft-closes the previous row (isActive=false,
// deactivatedAt set) instead of deleting it, so truthful history is preserved.
// The "one active ООО + one active ИП per club" invariant is enforced in code
// inside a transaction (Prisma cannot express a partial unique index); the
// @@unique([clubId, legalEntityId]) below still prevents duplicate associations.
model ClubLegalEntity {
  id            String    @id @default(cuid())
  clubId        String
  legalEntityId String
  isPrimary     Boolean   @default(false)
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  club        Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@unique([clubId, legalEntityId])
  @@index([clubId])
  @@index([legalEntityId])
}

// ---------------------------------------------------------------------------
// Access: company-scoped and club-scoped role assignments
// ---------------------------------------------------------------------------

// Company-wide role (owner, regional_director, manager, accountant).
model CompanyUserAccess {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, role])
  @@index([companyId])
  @@index([userId])
}

// Club-scoped role (regional_director, manager, accountant).
model ClubUserAccess {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId, role])
  @@index([clubId])
  @@index([userId])
}

// Pending invitation. Only the token hash is stored; the raw token is shown
// once at creation time and carried in the accept-invite link.
model Invite {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  email           String
  companyId       String
  clubId          String?
  role            String
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club      Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  invitedBy User    @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

model Refund {
  id              String   @id @default(cuid())
  companyId       String
  clubId          String
  createdByUserId String

  clientName     String?
  clientPhone    String?
  amountKopeks   Int      @default(0)
  currency       String   @default("RUB")
  reason         String?
  contractNumber String?
  refundDate     DateTime?

  bankRecipientName String?
  bankName          String?
  bankBik           String?
  bankAccount       String?
  // Correspondent account (additive; v2 requisites). Never store card/CVC/etc.
  bankCorrAccount   String?

  // draft | needs_review | approved_by_regional | approved_by_owner | paid | rejected
  status     String @default("draft")
  confidence String @default("low")
  paidAt     DateTime?

  // v2 refund type: membership | personal_training (nullable — legacy rows have
  // none and are never back-filled). Form version: 1 = legacy (documentsJson),
  // 2 = new slot-based form (RefundDocument).
  returnType   String?
  entryVersion Int     @default(1)

  // --- v2 membership refund calculation (Phase 2A; all nullable → legacy-safe).
  // Dates are stored at LOCAL midnight (date-only semantics). contractAmountKopeks
  // is the contract sum (kept SEPARATE from amountKopeks, which for v2 holds the
  // final refund result). Derived fields are recomputable from the operands +
  // calculationVersion so a historical calculation can be reproduced.
  serviceStartDate            DateTime?
  serviceEndDate              DateTime?
  applicationDate             DateTime?
  contractAmountKopeks        Int?
  serviceNotProvided          Boolean   @default(false)
  serviceDurationDays         Int?
  refundableDays              Int?
  refundResultAmountKopeks    Int?
  baseRefundDueDate           DateTime?
  plannedRefundDate           DateTime?
  dueDateAdjustmentReason     String?
  calculationVersion          String?

  // --- v2 personal-training refund calculation (Phase 2B; all nullable). Trainer
  // is a historical snapshot (id + name) so the record survives dismissal/rename.
  // ptRawResultKopeks is the SIGNED pre-round result (may be negative for the
  // contract-rate variant); refundResultAmountKopeks/amountKopeks never go
  // negative — a negative raw result is a refusal, not a stored negative amount.
  ptTrainerEmployeeId             String?
  ptTrainerNameSnapshot           String?
  ptContractSessionCount          Int?
  ptUsedSessionCount              Int?
  ptTerminationSessionPriceKopeks Int?
  ptCalculationMethod             String?
  ptAlternativeCalculationReason  String?
  ptRawResultKopeks               Int?
  ptRefundUnavailableReason       String?
  ptRefusalDraftText              String?

  // --- v2 review workflow (Phase 3A). New statuses (pending_regional_review /
  // needs_correction / accounting_in_progress) live in `status`; these are the
  // participant/time fields. History is kept in AuditLog. All nullable → legacy-safe.
  regionalReviewRequestedAt   DateTime?
  submittedByManagerId        String?
  regionalReviewedAt          DateTime?
  regionalReviewedByUserId    String?
  regionalCorrectionComment   String?
  accountingStartedAt         DateTime?

  // Uploaded documents: JSON array of { storageKey, fileName, mime, size, type }
  // (legacy v1). v2 refunds use the RefundDocument table instead.
  documentsJson    String?
  rawExtractedJson String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club      Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  documents RefundDocument[]

  @@index([companyId])
  @@index([clubId])
  @@index([createdByUserId])
  @@index([status])
}

// v2 refund document slot (additive; mirrors ExpenseDocument). Exactly one
// ACTIVE document per (refund, slot) is enforced by the unique activeSlotKey
// ("<refundId>:<documentType>", null when removed) — this also makes concurrent
// uploads to the same slot safe (the loser hits a unique violation). Files are
// soft-removed (removedAt), never hard-deleted. Keys are opaque + server-made.
model RefundDocument {
  id               String    @id @default(cuid())
  refundId         String
  companyId        String
  clubId           String
  // Slot key, validated against returnType in code (contract_page_1 | ...).
  documentType     String
  storageKey       String    @unique
  originalFilename String
  safeFilename     String
  mimeType         String
  sizeBytes        Int
  sha256           String
  uploadedByUserId String?
  activeSlotKey    String?   @unique
  createdAt        DateTime  @default(now())
  removedAt        DateTime?
  removedByUserId  String?
  removalReason    String?

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId])
  @@index([companyId, clubId])
  @@index([removedAt])
}

// Monthly spending limit per club + category (month = "YYYY-MM").
model Budget {
  id                String   @id @default(cuid())
  companyId         String
  clubId            String
  category          String
  month             String
  limitAmountKopeks Int
  createdByUserId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club      Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User    @relation("BudgetCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([clubId, category, month])
  @@index([companyId])
  @@index([clubId])
}

// Recurring or one-time mandatory payment (rent, salary, cleaning, security…).
// Feeds the payment calendar via PaymentObligation (sourceType = mandatory_payment).
// Allowed values enforced in src/lib/mandatory-payments.ts:
//   recurrence -> none | monthly
//   status     -> planned | paused | canceled
model MandatoryPaymentPlan {
  id                String    @id @default(cuid())
  companyId         String
  clubId            String
  category          String
  title             String
  amountKopeks      Int       @default(0)
  // For recurrence = monthly: the day-of-month the payment is due (1..31).
  dueDayOfMonth     Int?
  // For recurrence = none: the single due date.
  dueDate           DateTime?
  recurrence        String    @default("monthly")
  responsibleUserId String?
  // Which legal entity (ООО / ИП) pays this obligation. Nullable: existing rows
  // and unassigned plans fall back to "Юрлицо не указано".
  legalEntityId     String?
  status            String    @default("planned")
  notes             String?
  isActive          Boolean   @default(true)
  createdByUserId   String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("MandatoryPaymentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  responsible User?        @relation("MandatoryPaymentResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clubId])
}

// Append-only cash-balance log per club + legal entity. The latest snapshot (by
// snapshotDate) is the current balance. Old rows are never updated/deleted — a
// new balance is a new row (financial control history).
model BalanceSnapshot {
  id                  String   @id @default(cuid())
  companyId           String
  clubId              String
  legalEntityId       String
  snapshotDate        DateTime
  actualBalanceKopeks Int
  comment             String?
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("BalanceSnapshotCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([clubId])
  @@index([legalEntityId])
  @@index([clubId, legalEntityId, snapshotDate])
}

// Approval request raised when an operation would exceed the monthly budget.
model BudgetApprovalRequest {
  id                     String    @id @default(cuid())
  companyId              String
  clubId                 String
  category               String
  month                  String
  requestedAmountKopeks  Int
  currentLimitAmountKopeks Int
  overByAmountKopeks     Int
  overByPercent          Float
  sourceType             String
  sourceId               String?
  requestedByUserId      String
  // Automatic overrun workflow: pending | approved | rejected.
  // (Legacy manual workflow used pending_regional | pending_owner.)
  status                 String    @default("pending")
  // New automatic-overrun fields (legacy fields above kept for back-compat).
  budgetId               String?
  budgetAmountKopeks     Int       @default(0)
  currentSpentKopeks     Int       @default(0)
  projectedSpentKopeks   Int       @default(0)
  overrunKopeks          Int       @default(0)
  reason                 String?
  approvedByUserId       String?
  approvedAt             DateTime?
  rejectedByUserId       String?
  rejectedAt             DateTime?
  decidedByUserId        String?
  decidedAt              DateTime?
  decisionComment        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("BudgetReqRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy   User?   @relation("BudgetReqDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clubId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit log (decoupled scalar references so deleted entities stay traceable)
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  companyId    String?
  clubId       String?
  userId       String?
  action       String
  entityType   String
  entityId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Business records
// ---------------------------------------------------------------------------

model Invoice {
  id              String  @id @default(cuid())
  companyId       String
  clubId          String
  legalEntityId   String?
  createdByUserId String

  // Counterparty + payment requisites (nullable: filled by AI extraction or by hand)
  counterpartyName        String?
  counterpartyInn         String?
  counterpartyKpp         String?
  counterpartyBankName    String?
  counterpartyBankBik     String?
  counterpartyAccount     String?
  counterpartyCorrAccount String?

  // Payer (Плательщик) — the company paying; kept separate from the counterparty.
  payerName String?
  payerInn  String?
  payerKpp  String?

  amountKopeks    Int       @default(0)
  currency        String    @default("RUB")
  expenseCategory String?
  // Accounting month the expense belongs to ("YYYY-MM"); drives expenses /
  // profit / budget / analytics. Independent of paidAt (when money left).
  expensePeriod   String?
  subject         String?
  invoiceNumber   String?
  invoiceDate     DateTime?
  dueDate         DateTime?
  paidAt          DateTime?

  // draft | needs_review | approved | paid | rejected
  status String @default("draft")
  // low | medium | high (document recognition confidence)
  confidence String @default("low")

  // Uploaded document metadata (binary kept on disk, never in DB)
  originalFileName       String?
  originalFileMime       String?
  originalFileSize       Int?
  originalFileStorageKey String?
  rawExtractedJson       String?

  notes     String?
  comment   String?
  fileUrl   String?
  // Set when the row was created by an Excel import batch (for undo + dedup).
  importBatchId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  createdBy   User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([clubId])
  @@index([createdByUserId])
  @@index([status])
  @@index([dueDate])
  @@index([importBatchId])
}

model Expense {
  id              String   @id @default(cuid())
  companyId       String
  clubId          String
  legalEntityId   String?
  createdByUserId String

  // receipt | transfer | manual | payroll_statement
  type String @default("manual")

  // `category` holds the expense category; `expenseDate` is the purchase date.
  category     String
  vendorName   String?
  recipientName String?
  // Transfer purpose / comment (for type=transfer).
  transferComment String?
  amountKopeks Int      @default(0)
  currency     String   @default("RUB")
  expenseDate  DateTime
  address      String?
  itemsJson    String?

  confidence String @default("low")
  // confirmed (default for now; reserved for future workflow)
  status String @default("confirmed")

  paymentMethod String?
  comment       String?
  notes         String?

  // Uploaded document metadata (binary kept on disk, never in DB)
  originalFileName       String?
  originalFileMime       String?
  originalFileSize       Int?
  originalFileStorageKey String?
  rawExtractedJson       String?

  fileUrl   String?
  // Set when the row was created by an Excel import batch (for undo + dedup).
  importBatchId String?

  // --- Simplified cash-expense workflow (entryVersion=2). All additive/nullable;
  // legacy rows stay entryVersion=1 and keep their existing behavior. ---
  // 1 = legacy complex entry; 2 = simplified manager cash form.
  entryVersion Int @default(1)
  // One plain-text "Список покупок/оплат" field (not parsed for financial truth).
  shoppingListText String?
  // Auto-generated, sanitized title ("Категория: краткое содержание списка").
  generatedTitle   String?
  // The employee who physically paid (accountable foundation). Not the creator.
  paidByUserId     String?
  // AI receipt verification (advisory, read-only): not_started | pending |
  // matched | warning | failed | manual_review_required. aiCheckSummary is JSON.
  aiCheckStatus  String?
  aiCheckSummary String?
  // Workflow timestamps + actors (idempotent transitions).
  submittedAt                 DateTime?
  verifiedAt                  DateTime?
  verifiedByUserId            String?
  correctionRequestedAt       DateTime?
  correctionRequestedByUserId String?
  correctionReason            String?
  cancelledAt                 DateTime?
  cancelledByUserId           String?
  cancellationReason          String?
  // First-save timestamp for the regional 7-day date-edit window.
  firstSavedAt                DateTime?
  // Cash wallet the expense is paid from (club_cash for managers, regional_cash
  // for regional directors). Resolved server-side; a confirmed outgoing
  // CashMovement is created once at verification.
  cashWalletId                String?
  // Budget-overrun snapshot (integer money + basis points; never float).
  budgetOverrunKopeks        Int?
  budgetOverrunBasisPoints   Int?
  // within | regional | owner | none
  budgetApprovalLevel        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  paidBy      User?        @relation("ExpensePaidBy", fields: [paidByUserId], references: [id], onDelete: SetNull)
  documents   ExpenseDocument[]

  @@index([companyId])
  @@index([clubId])
  @@index([createdByUserId])
  @@index([category])
  @@index([expenseDate])
  @@index([importBatchId])
  @@index([status])
  @@index([entryVersion])
  @@index([paidByUserId])
}

// Multi-document attachments for simplified (entryVersion=2) expenses (Phase 2A).
// Additive: the legacy single-file fields on Expense (originalFileStorageKey…)
// remain and stay readable. companyId/clubId are stored for scope isolation;
// removal is a SOFT tombstone (removedAt/removedBy/removalReason), never a row
// delete in the normal flow. sha256 enables in-expense duplicate detection.
model ExpenseDocument {
  id               String    @id @default(cuid())
  expenseId        String
  companyId        String
  clubId           String
  storageKey       String    @unique // opaque, server-generated ("expense-docs/<hex>.<ext>")
  originalFilename String
  safeFilename     String
  mimeType         String
  sizeBytes        Int
  sha256           String
  // receipt | payment_confirmation | other (extensible; validated in code)
  documentType     String    @default("receipt")
  uploadedByUserId String?
  createdAt        DateTime  @default(now())
  removedAt        DateTime?
  removedByUserId  String?
  removalReason    String?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@index([companyId, clubId])
  @@index([createdAt])
  @@index([removedAt])
}

// Managed expense categories (Part 8). Chief accountant only may create/rename/
// disable/reactivate. `key` is the stable identifier stored on Expense.category;
// renames change `name` (history preserved in ExpenseCategoryNameHistory) but
// never the key, so historical rows stay correctly labelled.
model ExpenseCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nameHistory ExpenseCategoryNameHistory[]

  @@index([isActive])
}

model ExpenseCategoryNameHistory {
  id              String   @id @default(cuid())
  categoryId      String
  name            String
  changedByUserId String?
  changedAt       DateTime @default(now())

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

// Cash wallets: physical cash held for a Club's active ИП, separated by holder.
// club_cash = money at the Club desk (holderUserId null); regional_cash = money a
// regional director holds for that Club (holderUserId required). Regional money
// from different Clubs is never mixed (scoped by clubId+legalEntityId+holder).
// Additive; balances are derived ONLY from confirmed CashMovement (never stored).
model CashWallet {
  id            String   @id @default(cuid())
  companyId     String
  clubId        String
  legalEntityId String
  type          String // club_cash | regional_cash
  holderUserId  String? // null for club_cash; required (in code) for regional_cash
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  movementsFrom CashMovement[] @relation("FromWallet")
  movementsTo   CashMovement[] @relation("ToWallet")

  @@index([companyId])
  @@index([clubId, legalEntityId])
  @@index([holderUserId])
  // One regional_cash wallet per (Club, ИП, holder). club_cash uniqueness
  // (one per Club+ИП, holder null) is enforced in code (NULLs aren't unique).
  @@unique([clubId, legalEntityId, type, holderUserId])
}

// Immutable-ledger cash movements. ONLY confirmed rows affect balances. A wallet
// balance = Σ(confirmed toWallet) − Σ(confirmed fromWallet). Integer kopeks.
// (sourceType, sourceId) is unique → idempotent movement per source event (an
// Expense verification, a transfer, an other-income confirmation, an opening
// balance). Multiple NULL sources (adjustments) are allowed.
model CashMovement {
  id                String    @id @default(cuid())
  companyId         String
  clubId            String
  legalEntityId     String
  // opening_balance | ofd_cash_income | other_cash_income | internal_transfer |
  // expense | cash_refund | adjustment
  type              String
  amountKopeks      Int
  fromWalletId      String?
  toWalletId        String?
  status            String    @default("confirmed") // draft | pending_confirmation | confirmed | rejected | cancelled
  occurredAt        DateTime
  createdByUserId   String?
  confirmedByUserId String?
  confirmedAt       DateTime?
  sourceType        String?
  sourceId          String?
  comment           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club       Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  fromWallet CashWallet? @relation("FromWallet", fields: [fromWalletId], references: [id], onDelete: SetNull)
  toWallet   CashWallet? @relation("ToWallet", fields: [toWalletId], references: [id], onDelete: SetNull)

  @@unique([sourceType, sourceId])
  @@index([clubId, legalEntityId, status])
  @@index([toWalletId, status])
  @@index([fromWalletId, status])
  @@index([type])
  @@index([occurredAt])
}

// Minimal internal persistent notification (no external email/telegram/sms).
// Currently used for regional_cash negative-balance threshold crossings. Targeted
// by role (chief_accountant / owner) for a Company+Club. dedupeKey makes creation
// idempotent per (wallet, threshold, role, triggering movement) so a repeated /
// parallel confirm never duplicates, while a NEW downward crossing (new movement)
// is allowed. Additive — no existing model changed.
model CashNotification {
  id                 String    @id @default(cuid())
  companyId          String
  clubId             String
  walletId           String
  recipientRole      String // chief_accountant | owner
  type               String // regional_cash_negative_threshold
  thresholdKopeks    Int
  balanceKopeks      Int
  regionalDirectorId String?
  title              String
  message            String
  linkPath           String?
  dedupeKey          String    @unique
  readAt             DateTime?
  createdAt          DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, recipientRole, readAt])
  @@index([clubId])
  @@index([walletId])
}

model Sale {
  id              String   @id @default(cuid())
  companyId       String
  clubId          String
  legalEntityId   String?
  createdByUserId String
  source          String
  amountKopeks    Int
  saleDate        DateTime
  comment         String?

  // Accountant verification workflow. Only "confirmed" sales are realized
  // revenue. pending_accountant | confirmed | rejected | canceled.
  status           String    @default("pending_accountant")
  submittedByUserId String?
  verifiedByUserId  String?
  verifiedAt        DateTime?
  rejectedByUserId  String?
  rejectedAt        DateTime?
  rejectionReason   String?
  notes             String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  createdBy   User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([clubId])
  @@index([createdByUserId])
  @@index([source])
  @@index([saleDate])
  @@index([status])
}

model UserClubAccess {
  id        String   @id @default(cuid())
  userId    String
  clubId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([userId])
  @@index([clubId])
}

// Payroll cash statements (зарплатные ведомости). Only rows with a visible
// signature count as paid; re-uploads add only newly signed rows (dedup by
// rowHash). Amounts are in kopeks, matching the rest of the app.
model PayrollStatement {
  id              String @id @default(cuid())
  companyId       String
  clubId          String
  createdByUserId String

  period String? // e.g. "2026-06" or free-form label
  // Sum of all signed rows seen in this statement, and the subset newly counted.
  totalSignedAmountKopeks Int @default(0)
  newSignedAmountKopeks   Int @default(0)

  status String @default("confirmed")

  originalFileName       String?
  originalFileMime       String?
  originalFileSize       Int?
  originalFileStorageKey String?
  rawExtractedJson       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club      Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  rows      PayrollStatementRow[]

  @@index([companyId])
  @@index([clubId])
  @@index([createdByUserId])
}

// One employee row from a payroll statement. The unique (companyId, clubId,
// rowHash) lets repeated uploads converge on the same row so an already-counted
// signed row is never counted twice.
model PayrollStatementRow {
  id                 String @id @default(cuid())
  payrollStatementId String
  companyId          String
  clubId             String

  employeeName String?
  role         String?
  amountKopeks Int     @default(0)

  isSigned                    Boolean @default(false)
  // low | medium | high — how sure we are a signature is present.
  signatureDetectedConfidence String  @default("low")

  // Hash of normalized employeeName + role + amount + period (dedup key).
  rowHash   String
  // Set when this row's amount was counted into an expense; null = not counted.
  countedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statement PayrollStatement @relation(fields: [payrollStatementId], references: [id], onDelete: Cascade)

  @@unique([companyId, clubId, rowHash])
  @@index([payrollStatementId])
  @@index([companyId])
  @@index([clubId])
}

// Monthly sales target (план продаж) set by the general director. clubId null =
// company-wide plan; a club id = per-club plan. month = "YYYY-MM".
model SalesPlan {
  id                String   @id @default(cuid())
  companyId         String
  clubId            String?
  month             String
  // total | subscriptions | personal_training (existing rows default to total)
  planType          String   @default("total")
  targetAmountKopeks Int     @default(0)
  createdByUserId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club      Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([companyId, clubId, month, planType])
  @@index([companyId])
  @@index([clubId])
  @@index([month])
}

// ---------------------------------------------------------------------------
// Daily sales report (сменный отчёт) — the real-club report structure. A manager
// submits a report (many named amount lines) for accountant verification; only
// "confirmed" reports count as realized revenue (their total_revenue line).
// ---------------------------------------------------------------------------
model SalesReport {
  id               String    @id @default(cuid())
  companyId        String
  clubId           String
  reportDate       DateTime
  managerName      String?
  createdByUserId  String
  // pending_accountant | confirmed | rejected | canceled
  status           String    @default("pending_accountant")
  verifiedByUserId String?
  verifiedAt       DateTime?
  accountantComment String?
  rejectedByUserId String?
  rejectedAt       DateTime?
  rejectionReason  String?
  notes            String?
  // Set when the row was created by an Excel import batch (for undo).
  importBatchId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Controlled shift-manager selection (new reports). managerName stays as a
  // display snapshot for back-compat + analytics; legacy rows have only the name.
  managerEmployeeId String?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club      Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User    @relation("SalesReportCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  managerEmployee ClubEmployee? @relation(fields: [managerEmployeeId], references: [id], onDelete: SetNull)
  lines     SalesReportLine[]
  documents SalesReportDocument[]

  @@index([companyId])
  @@index([clubId])
  @@index([status])
  @@index([reportDate])
  @@index([importBatchId])
}

// Operational club staff (NOT a system login user). Manager / administrator /
// trainer / night manager. Dismissed employees stay in history.
model ClubEmployee {
  id          String    @id @default(cuid())
  companyId   String
  clubId      String
  fullName    String
  // manager | administrator | gym_trainer | group_trainer | night_manager
  position    String
  // active | dismissed
  status      String    @default("active")
  dismissedAt DateTime?
  comment     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club         Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  salesReports SalesReport[]

  @@index([companyId])
  @@index([clubId])
  @@index([clubId, position, status])
}

// Tracks one Excel import run so duplicate files can be blocked and a whole
// import can be undone. Every row created by an import stores its importBatchId.
model ImportBatch {
  id               String    @id @default(cuid())
  companyId        String
  clubId           String?
  // sales_reports | expenses | invoices
  type             String
  fileName         String?
  fileHash         String?
  // completed | reverted | failed
  status           String    @default("completed")
  createdByUserId  String
  createdAt        DateTime  @default(now())
  revertedByUserId String?
  revertedAt       DateTime?
  rowsCreated      Int       @default(0)
  rowsSkipped      Int       @default(0)
  rowsDuplicated   Int       @default(0)
  rowsErrored      Int       @default(0)
  summaryJson      String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([type])
  @@index([fileHash])
  @@index([createdByUserId])
}

// Month closing: once a (company [+ club] + month) is closed, financial changes
// for that period are blocked server-side. clubId null = company-wide close.
model MonthClose {
  id             String    @id @default(cuid())
  companyId      String
  clubId         String?
  month          String // "YYYY-MM"
  // open | closed
  status         String    @default("closed")
  closedByUserId String?
  closedAt       DateTime?
  comment        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, clubId, month])
  @@index([companyId])
  @@index([month])
}

// Controlled month reopening: the Chief Accountant requests a reopen for a
// closed month; the Owner approves/rejects; the Chief Accountant then executes
// an approved request (which reopens the MonthClose). Direct reopening is not
// allowed. Scope mirrors MonthClose (clubId null = company-wide). Requests are
// never hard-deleted; status carries the full history.
model MonthReopenRequest {
  id                String    @id @default(cuid())
  companyId         String
  clubId            String?
  month             String // "YYYY-MM"
  // pending | approved | rejected | executed | canceled
  status            String    @default("pending")
  reason            String
  requestedByUserId String
  requestedAt       DateTime  @default(now())
  reviewedByUserId  String?
  reviewedAt        DateTime?
  reviewComment     String?
  executedByUserId  String?
  executedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Fast lookup of the (at most one) active request per scope + month.
  @@index([companyId, clubId, month, status])
  @@index([companyId])
  @@index([status])
}

model SalesReportLine {
  id            String   @id @default(cuid())
  salesReportId String
  key           String
  label         String
  amountKopeks  Int      @default(0)
  sortOrder     Int      @default(0)
  // Accounting entity this row belongs to (ООО rows -> ООО, ИП rows -> ИП).
  legalEntityId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  report      SalesReport  @relation(fields: [salesReportId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)

  @@index([salesReportId])
  @@index([legalEntityId])
}

model SalesReportDocument {
  id               String   @id @default(cuid())
  salesReportId    String
  // encashment | cash_report | acquiring_report | other
  type             String   @default("other")
  originalFileName String
  originalFileMime String
  originalFileSize Int
  storageKey       String?
  uploadedByUserId String
  createdAt        DateTime @default(now())

  report SalesReport @relation(fields: [salesReportId], references: [id], onDelete: Cascade)

  @@index([salesReportId])
}
