generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Temporarily on SQLite for local beta (no Docker/Postgres required).
  // Switch back to "postgresql" for staging/production.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite does not support Prisma enums, so `role` and `status` are stored
// as TEXT. Allowed values are still enforced in application code:
//   - Role         -> src/lib/auth.ts
//   - InvoiceStatus -> src/lib/invoices.ts

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubAccess UserClubAccess[]
  invoices   Invoice[]
  expenses   Expense[]
}

model Club {
  id        String   @id @default(cuid())
  name      String
  city      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userAccess UserClubAccess[]
  invoices   Invoice[]
  expenses   Expense[]
}

model Invoice {
  id               String    @id @default(cuid())
  clubId           String
  createdByUserId  String
  counterpartyName String
  amountKopeks     Int
  subject          String
  invoiceDate      DateTime
  dueDate          DateTime
  paidAt           DateTime?
  status           String    @default("unpaid")
  comment          String?
  fileUrl          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([clubId])
  @@index([createdByUserId])
  @@index([status])
  @@index([dueDate])
}

model Expense {
  id              String    @id @default(cuid())
  clubId          String
  createdByUserId String
  category        String
  vendorName      String?
  amountKopeks    Int
  expenseDate     DateTime
  paymentMethod   String?
  comment         String?
  fileUrl         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  club      Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([clubId])
  @@index([createdByUserId])
  @@index([category])
  @@index([expenseDate])
}

model UserClubAccess {
  id        String   @id @default(cuid())
  userId    String
  clubId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([userId])
  @@index([clubId])
}
