generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Temporarily on SQLite for local beta (no Docker/Postgres required).
  // Switch back to "postgresql" for staging/production.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite does not support Prisma enums, so roles/status/types are stored
// as TEXT. Allowed values are enforced in application code:
//   - Role          -> src/lib/auth.ts
//   - InvoiceStatus  -> src/lib/invoices.ts
//   - Company/club roles & legal-entity type -> src/lib/access.ts

// ---------------------------------------------------------------------------
// Tenancy: Company -> Club, plus legal entities (ООО / ИП)
// ---------------------------------------------------------------------------

model Company {
  id        String   @id @default(cuid())
  name      String
  inn       String?
  kpp       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubs         Club[]
  legalEntities LegalEntity[]
  userAccess    CompanyUserAccess[]
  invites       Invite[]
  invoices      Invoice[]
  expenses      Expense[]
  sales         Sale[]
  refunds       Refund[]
  budgets       Budget[]
  budgetRequests BudgetApprovalRequest[]
}

model LegalEntity {
  id            String   @id @default(cuid())
  companyId     String
  type          String // "ООО" | "ИП"
  name          String
  inn           String?
  ogrn          String?
  bankName      String?
  accountNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clubs    ClubLegalEntity[]
  invoices Invoice[]
  expenses Expense[]
  sales    Sale[]

  @@index([companyId])
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  role            String
  passwordHash    String?
  firstName       String?
  lastName        String?
  phone           String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  clubAccess    UserClubAccess[]
  companyAccess CompanyUserAccess[]
  clubRoles     ClubUserAccess[]
  sessions      Session[]
  invitesSent   Invite[]
  invoices      Invoice[]
  expenses      Expense[]
  sales         Sale[]
  refunds       Refund[]
  budgetsCreated          Budget[]                @relation("BudgetCreatedBy")
  budgetRequestsRequested BudgetApprovalRequest[] @relation("BudgetReqRequestedBy")
  budgetRequestsDecided   BudgetApprovalRequest[] @relation("BudgetReqDecidedBy")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Club {
  id        String   @id @default(cuid())
  companyId String
  name      String
  city      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userAccess    UserClubAccess[]
  clubRoles     ClubUserAccess[]
  legalEntities ClubLegalEntity[]
  invites       Invite[]
  invoices      Invoice[]
  expenses      Expense[]
  sales         Sale[]
  refunds       Refund[]
  budgets       Budget[]
  budgetRequests BudgetApprovalRequest[]

  @@index([companyId])
}

// A club can be served by multiple legal entities (e.g. ООО + ИП).
model ClubLegalEntity {
  id            String   @id @default(cuid())
  clubId        String
  legalEntityId String
  createdAt     DateTime @default(now())

  club        Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)

  @@unique([clubId, legalEntityId])
  @@index([clubId])
  @@index([legalEntityId])
}

// ---------------------------------------------------------------------------
// Access: company-scoped and club-scoped role assignments
// ---------------------------------------------------------------------------

// Company-wide role (owner, regional_director, manager, accountant).
model CompanyUserAccess {
  id        String   @id @default(cuid())
  companyId String
  userId    String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, role])
  @@index([companyId])
  @@index([userId])
}

// Club-scoped role (regional_director, manager, accountant).
model ClubUserAccess {
  id        String   @id @default(cuid())
  clubId    String
  userId    String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId, role])
  @@index([clubId])
  @@index([userId])
}

// Pending invitation. Only the token hash is stored; the raw token is shown
// once at creation time and carried in the accept-invite link.
model Invite {
  id              String    @id @default(cuid())
  tokenHash       String    @unique
  email           String
  companyId       String
  clubId          String?
  role            String
  invitedByUserId String
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club      Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  invitedBy User    @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
}

model Refund {
  id              String   @id @default(cuid())
  companyId       String
  clubId          String
  createdByUserId String

  clientName     String?
  clientPhone    String?
  amountKopeks   Int      @default(0)
  currency       String   @default("RUB")
  reason         String?
  contractNumber String?
  refundDate     DateTime?

  bankRecipientName String?
  bankName          String?
  bankBik           String?
  bankAccount       String?

  // draft | needs_review | approved_by_regional | approved_by_owner | paid | rejected
  status     String @default("draft")
  confidence String @default("low")
  paidAt     DateTime?

  // Uploaded documents: JSON array of { storageKey, fileName, mime, size, type }
  documentsJson    String?
  rawExtractedJson String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club      Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([clubId])
  @@index([createdByUserId])
  @@index([status])
}

// Monthly spending limit per club + category (month = "YYYY-MM").
model Budget {
  id                String   @id @default(cuid())
  companyId         String
  clubId            String
  category          String
  month             String
  limitAmountKopeks Int
  createdByUserId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club      Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  createdBy User    @relation("BudgetCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([clubId, category, month])
  @@index([companyId])
  @@index([clubId])
}

// Approval request raised when an operation would exceed the monthly budget.
model BudgetApprovalRequest {
  id                     String    @id @default(cuid())
  companyId              String
  clubId                 String
  category               String
  month                  String
  requestedAmountKopeks  Int
  currentLimitAmountKopeks Int
  overByAmountKopeks     Int
  overByPercent          Float
  sourceType             String
  sourceId               String?
  requestedByUserId      String
  // pending_regional | pending_owner | approved | rejected
  status                 String    @default("pending_regional")
  decidedByUserId        String?
  decidedAt              DateTime?
  decisionComment        String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("BudgetReqRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedBy   User?   @relation("BudgetReqDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([clubId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit log (decoupled scalar references so deleted entities stay traceable)
// ---------------------------------------------------------------------------

model AuditLog {
  id           String   @id @default(cuid())
  companyId    String?
  clubId       String?
  userId       String?
  action       String
  entityType   String
  entityId     String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Business records
// ---------------------------------------------------------------------------

model Invoice {
  id              String  @id @default(cuid())
  companyId       String
  clubId          String
  legalEntityId   String?
  createdByUserId String

  // Counterparty + payment requisites (nullable: filled by AI extraction or by hand)
  counterpartyName        String?
  counterpartyInn         String?
  counterpartyKpp         String?
  counterpartyBankName    String?
  counterpartyBankBik     String?
  counterpartyAccount     String?
  counterpartyCorrAccount String?

  // Payer (Плательщик) — the company paying; kept separate from the counterparty.
  payerName String?
  payerInn  String?
  payerKpp  String?

  amountKopeks    Int       @default(0)
  currency        String    @default("RUB")
  expenseCategory String?
  subject         String?
  invoiceNumber   String?
  invoiceDate     DateTime?
  dueDate         DateTime?
  paidAt          DateTime?

  // draft | needs_review | approved | paid | rejected
  status String @default("draft")
  // low | medium | high (document recognition confidence)
  confidence String @default("low")

  // Uploaded document metadata (binary kept on disk, never in DB)
  originalFileName       String?
  originalFileMime       String?
  originalFileSize       Int?
  originalFileStorageKey String?
  rawExtractedJson       String?

  notes     String?
  comment   String?
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  createdBy   User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([clubId])
  @@index([createdByUserId])
  @@index([status])
  @@index([dueDate])
}

model Expense {
  id              String   @id @default(cuid())
  companyId       String
  clubId          String
  legalEntityId   String?
  createdByUserId String

  // receipt | transfer | manual
  type String @default("manual")

  // `category` holds the expense category; `expenseDate` is the purchase date.
  category     String
  vendorName   String?
  recipientName String?
  amountKopeks Int      @default(0)
  currency     String   @default("RUB")
  expenseDate  DateTime
  address      String?
  itemsJson    String?

  confidence String @default("low")
  // confirmed (default for now; reserved for future workflow)
  status String @default("confirmed")

  paymentMethod String?
  comment       String?
  notes         String?

  // Uploaded document metadata (binary kept on disk, never in DB)
  originalFileName       String?
  originalFileMime       String?
  originalFileSize       Int?
  originalFileStorageKey String?
  rawExtractedJson       String?

  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  createdBy   User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([clubId])
  @@index([createdByUserId])
  @@index([category])
  @@index([expenseDate])
}

model Sale {
  id              String   @id @default(cuid())
  companyId       String
  clubId          String
  legalEntityId   String?
  createdByUserId String
  source          String
  amountKopeks    Int
  saleDate        DateTime
  comment         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  club        Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  legalEntity LegalEntity? @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  createdBy   User         @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([clubId])
  @@index([createdByUserId])
  @@index([source])
  @@index([saleDate])
}

model UserClubAccess {
  id        String   @id @default(cuid())
  userId    String
  clubId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([userId])
  @@index([clubId])
}
