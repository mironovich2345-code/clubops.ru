# ─────────────────────────────────────────────────────────────────────────────
# CLUB-OPS — PRODUCTION environment (RU infrastructure)
# Copy to .env.production (gitignored) and fill with REAL values. Never commit
# secrets. See docs/RU_DEPLOYMENT.md and docs/COMPLIANCE_RU.md.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV="production"
# Port the Next.js server listens on (the platform may override).
PORT="3000"
# Public base URL — used to mint ABSOLUTE links (invitations, email, canonical /
# OpenGraph metadata). Must be a valid https:// URL in production; it is NOT
# derived from request headers and never falls back to the Railway hostname.
# This pilot client deployment:
APP_URL="https://pilot.clubops.ru"

# ── Database — PostgreSQL in Russia ─────────────────────────────────────────
# Managed (Yandex Cloud / Selectel / VK Cloud) or the bundled `postgres` service.
# For the bundled service use: postgresql://USER:PASSWORD@postgres:5432/DBNAME
DATABASE_URL="postgresql://club_ops:CHANGE_ME@postgres:5432/club_ops?sslmode=prefer"

# Used by the bundled docker-compose `postgres` service (ignore for managed DB).
POSTGRES_DB="club_ops"
POSTGRES_USER="club_ops"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# ── Sessions ────────────────────────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -hex 32
SESSION_SECRET="CHANGE_ME_LONG_RANDOM_SECRET"

# ── File storage — S3-compatible object storage in Russia ───────────────────
# Use a Russian provider's Object Storage (S3 API). Examples:
#   Yandex Object Storage : S3_ENDPOINT=https://storage.yandexcloud.net   S3_REGION=ru-central1
#   Selectel Object Storage: S3_ENDPOINT=https://s3.ru-1.storage.selcloud.ru  S3_REGION=ru-1
#   VK Cloud Object Storage: S3_ENDPOINT=https://hb.ru-msk.vkcloud-storage.ru S3_REGION=ru-msk
STORAGE_PROVIDER="s3"
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET="club-ops-documents"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"

# To keep local-disk storage instead (requires a persistent mounted volume),
# set STORAGE_PROVIDER="local" and leave the S3_* values blank.

# ── AI document recognition ─────────────────────────────────────────────────
# Recommended for production (RU): "yandex". OpenAI is dev/test only.
#   "" / unset → mock (no external calls) — SAFE DEFAULT for personal data.
#   "yandex"   → PRODUCTION (RU). Yandex Vision OCR + YandexGPT; data stays in RU.
#                Requires YANDEX_AI_API_KEY + YANDEX_FOLDER_ID (else → mock/manual).
#   "openai"   → DEV/TEST ONLY. Sends images to OpenAI (data leaves RU + 403 from
#                a RU VM). Do NOT process personal data this way without a lawful
#                basis (see docs/COMPLIANCE_RU.md).
#   "ru_ai"    → reserved placeholder for another provider (not wired up).
AI_PROVIDER=""

# Yandex Cloud AI (invoice recognition). REQUIRED when AI_PROVIDER=yandex.
# Create an API key for a service account with ai.vision.user + ai.languageModels.user.
YANDEX_AI_API_KEY=""
YANDEX_FOLDER_ID=""
# Optional tuning (safe defaults applied when unset):
# YANDEX_OCR_MODEL="page"
# YANDEX_GPT_MODEL="yandexgpt-5-lite"     # bare name → gpt://<folder>/<name>
# YANDEX_AI_TIMEOUT_MS="60000"
# YANDEX_OCR_LANGUAGE_CODES="*"
# YANDEX_DATA_LOGGING_ENABLED="false"     # keep false in production (privacy)

# OpenAI — DEV/TEST ONLY. Leave empty in production unless explicitly approved.
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Russian AI/OCR provider (reserved placeholder until implemented).
RU_AI_ENDPOINT=""
RU_AI_API_KEY=""

# ── Email OTP two-factor ─────────────────────────────────────────────────────
# Dedicated OTP HMAC key (MUST differ from SESSION_SECRET / SMTP / DB secrets).
OTP_SECRET=""
# Account deletion/recovery key: AES-256-GCM email encryption + recovery-token
# HMAC. MUST be >=32 random chars and DISTINCT from every other secret
# (openssl rand -hex 32). Per-customer deployments MUST use a unique value.
ACCOUNT_RECOVERY_SECRET=""
# Mail.ru SMTP for OTP delivery.
SMTP_HOST="smtp.mail.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
