# ─────────────────────────────────────────────────────────────────────────────
# CLUB-OPS — local development environment
# Copy to .env (gitignored) and adjust. For production see .env.production.example
# ─────────────────────────────────────────────────────────────────────────────

# Database — SQLite for local dev.
DATABASE_URL="file:./dev.db"

# Session token HMAC key. Any non-empty string for dev; use a long random value
# in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET="change-me-in-production"

# Public base URL — used to mint absolute links (invitations, email, metadata).
# Optional in dev (defaults to http://localhost:3000). In production set a valid
# https:// URL, e.g. APP_URL=https://pilot.clubops.ru
APP_URL="http://localhost:3000"

# ── File storage ────────────────────────────────────────────────────────────
# "local" stores uploads under ./uploads (default, dev). "s3" uses S3-compatible
# object storage (see .env.production.example). Leave as local for dev.
STORAGE_PROVIDER="local"
# The S3_* values below are only read when STORAGE_PROVIDER=s3.
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ── AI document recognition (optional) ──────────────────────────────────────
# Leave AI_PROVIDER empty (or unset) for the safe mock fallback — no external calls.
#   yandex → PRODUCTION (RU). Yandex Vision OCR + YandexGPT (data stays in RU).
#   openai → DEV/TEST ONLY. Sends document images to OpenAI (data leaves RU).
#   ru_ai  → reserved placeholder for another Russian provider (not wired up).
AI_PROVIDER=""

# Yandex Cloud AI (invoice OCR). Required when AI_PROVIDER=yandex; without both
# the app falls back to mock (dev/test) — the key is never logged.
YANDEX_AI_API_KEY=""
YANDEX_FOLDER_ID=""
# Optional Yandex tuning (safe defaults shown):
# YANDEX_OCR_MODEL="page"
# YANDEX_GPT_MODEL="yandexgpt-5-lite"   # bare name → gpt://<folder>/<name>
# YANDEX_AI_TIMEOUT_MS="60000"
# YANDEX_OCR_ASYNC_TIMEOUT_MS="90000"   # deadline for multi-page PDF async OCR
# YANDEX_OCR_LANGUAGE_CODES="*"
# YANDEX_DATA_LOGGING_ENABLED="false"   # keep false: do not let Yandex retain payloads

# OpenAI — DEV/TEST ONLY. Do not use for real personal data (see docs/COMPLIANCE_RU.md).
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# Russian AI/OCR provider (reserved placeholder — fill when available).
RU_AI_ENDPOINT=""
RU_AI_API_KEY=""

# ── Telegram notifications (optional; OFF by default) ────────────────────────
# When != "true" nothing is sent and business flows are unaffected.
TELEGRAM_NOTIFICATIONS_ENABLED="false"
# BotFather token — REQUIRED when enabled. Never logged.
TELEGRAM_BOT_TOKEN=""
# Bot @username (without @) — used to build the t.me/<bot>?start=<code> link.
TELEGRAM_BOT_USERNAME=""
# Secret checked on the webhook header X-Telegram-Bot-Api-Secret-Token
# (set the same value at setWebhook time). `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=""
# Bearer secret for POST /api/internal/notifications/drain (cron). `openssl rand -hex 32`.
NOTIFICATION_DRAIN_SECRET=""

# ── Email OTP two-factor (mandatory login second factor) ─────────────────────
# Dedicated HMAC key for OTP digests. MUST differ from SESSION_SECRET / SMTP /
# DB secrets. Required in production (e.g. `openssl rand -hex 32`).
OTP_SECRET="change-me-otp-secret"
# Dedicated key for account deletion/recovery (AES-256-GCM email encryption +
# recovery-token HMAC). MUST be >=32 chars and DISTINCT from SESSION_SECRET /
# OTP_SECRET / SMTP / DB. Required only for deletion/recovery in production.
ACCOUNT_RECOVERY_SECRET="change-me-account-recovery-secret-32b"
# Local dev: capture OTP via an in-memory test transport (printed to the dev
# console) instead of real SMTP. Fail-closed in production (ignored there).
OTP_TEST_TRANSPORT="1"

# ── Mail.ru SMTP (OTP delivery in production) ────────────────────────────────
SMTP_HOST="smtp.mail.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
