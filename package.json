{
  "name": "club-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "prisma:sync-prod": "node scripts/sync-prod-schema.mjs",
    "prisma:generate:prod": "prisma generate --schema=prisma/production/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/production/schema.prisma",
    "build:prod": "prisma generate --schema=prisma/production/schema.prisma && next build",
    "smoke:manager": "node scripts/smoke-manager-access.mjs",
    "smoke:manager-dashboard": "node scripts/smoke-manager-dashboard.mjs",
    "pilot:club": "node scripts/pilot-club-legal-entity.mjs",
    "docker:build": "docker build -t club-ops:latest .",
    "docker:prod": "docker compose -f docker-compose.production.yml up -d --build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "next": "^15.0.3",
    "prisma": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
