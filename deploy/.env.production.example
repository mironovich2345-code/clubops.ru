# ─────────────────────────────────────────────────────────────────────────────
# CLUB-OPS — /opt/club-ops/.env for the Yandex Cloud VM stack
# (deploy/docker-compose.prod.yml). Copy to /opt/club-ops/.env on the SERVER and
# fill REAL values there. NEVER commit real secrets. Generate secrets with:
#   openssl rand -hex 32
# The DB host is the compose service/container name: club-ops-postgres.
# ─────────────────────────────────────────────────────────────────────────────

# ── Deployment metadata / image source ──────────────────────────────────────
# Registry repo the VM pulls (deploy.sh appends :main). Registry id is NOT a secret.
APP_IMAGE_REPO="cr.yandex/REPLACE_WITH_REGISTRY_ID/club-ops"
# Public domain served by Caddy (A record must point at the VM's public IP).
SITE_DOMAIN="app.example.ru"
# Public base URL used for absolute links / email (must match SITE_DOMAIN, https).
APP_URL="https://app.example.ru"
# Non-secret deployment metadata surfaced by /api/health.
APP_ENVIRONMENT="production"
NODE_ENV="production"

# ── Database (bundled PostgreSQL 16 container: club-ops-postgres) ────────────
POSTGRES_DB="clubops"
POSTGRES_USER="clubops"
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PASSWORD"
DATABASE_URL="postgresql://clubops:CHANGE_ME_STRONG_PASSWORD@club-ops-postgres:5432/clubops?sslmode=disable"

# ── Sessions / OTP / recovery (REQUIRED, all DISTINCT random values) ─────────
SESSION_SECRET="CHANGE_ME_openssl_rand_hex_32"
OTP_SECRET="CHANGE_ME_openssl_rand_hex_32"
ACCOUNT_RECOVERY_SECRET="CHANGE_ME_openssl_rand_hex_32"

# ── Object Storage (Yandex Object Storage, private bucket) ───────────────────
STORAGE_PROVIDER="s3"
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_REGION="ru-central1"
S3_BUCKET="club-ops-prod-documents-7f3a9c"
S3_ACCESS_KEY_ID="CHANGE_ME"
S3_SECRET_ACCESS_KEY="CHANGE_ME"

# ── SMTP (OTP + notifications) ───────────────────────────────────────────────
SMTP_HOST="smtp.mail.ru"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ── AI document recognition (keep off / mock unless a lawful basis exists) ───
AI_PROVIDER=""
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
RU_AI_ENDPOINT=""
RU_AI_API_KEY=""
