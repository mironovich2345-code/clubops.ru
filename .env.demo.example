# Isolated demo only. Never use production credentials or the regular .env database.
DEMO_MODE=true
APP_ENVIRONMENT=standalone-demo
APP_URL=http://127.0.0.1:3100
DEMO_ALLOWED_HOST=127.0.0.1:3100
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/clubops_demo_test
DEMO_DATABASE_NAME=clubops_demo_test
DEMO_DATABASE_HOST=127.0.0.1:55432
ALLOW_DB_LOCALHOST=true
# Generate separate random values locally (openssl rand -hex 32), never share them.
SESSION_SECRET=
DEMO_CLEANUP_SECRET=
STORAGE_PROVIDER=local
AI_PROVIDER=mock
OFD_INTEGRATIONS_ENABLED=false
TELEGRAM_NOTIFICATIONS_ENABLED=false
